DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/cfa

# Hugging Face Inference (free) for dynamic aspect extraction.
# Set HF_TOKEN to enable LLM-based entity/sentiment extraction (no fixed entity list).
# Without it, the offline keyword lexicon is used as a fallback.
# Optional: HF_MODEL to pick a different instruct model.
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.1
